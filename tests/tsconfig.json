{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../.test-build",
    "types": ["node"]
  },
  "include": ["./*.test.ts", "./*.test.tsx"]
}
